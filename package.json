{
  "name": "anchorpoint-static-site",
  "private": true,
  "version": "1.0.0",
  "description": "Anchor Point static site with local compile step",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "axe-core": "^4.13.0",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.0.1",
    "live-server": "^1.2.2"
  },
  "scripts": {
    "build": "node scripts/build-static.mjs",
    "build:production": "node scripts/build-static.mjs --environment=production",
    "build:staging": "node scripts/build-static.mjs --environment=staging",
    "serve:dist": "live-server dist --port=8080 --quiet",
    "watch": "chokidar \"*.html\" \"css/**/*\" \"js/**/*\" \"img/**/*\" \"partials/**/*\" \"public/**/*\" -i \"dist/**\" --initial -c \"npm run build -- --environment=development\"",
    "dev": "concurrently -k -n WATCH,SERVER -c yellow,cyan \"npm:watch\" \"npm:serve:dist\"",
    "clean": "rm -rf dist",
    "preview": "python3 -m http.server 8080 --directory dist",
    "test:a11y": "npm run build && playwright test"
  }
}
